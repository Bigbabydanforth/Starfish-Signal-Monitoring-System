# =============================================
# Starfish Signal Monitor — Environment Variables
# Copy this file to .env and fill in all values
# NEVER commit .env to Git
# =============================================

# --- Apollo API (Job Change Tracking) ---
APOLLO_API_KEY=
APOLLO_API_URL=https://api.apollo.io/v1

# --- MediaStack API (News & Press Monitoring) ---
MEDIASTACK_API_KEY=
MEDIASTACK_API_URL=https://api.mediastack.com/v1

# --- PDL API (Primary Job Change Source) ---
PDL_API_KEY=
PDL_API_URL=https://api.peopledatalabs.com/v5

# --- NewsAPI (M&A & Funding News) ---
NEWSAPI_API_KEY=
NEWSAPI_API_URL=https://newsapi.org/v2

# --- PredictLeads API (M&A Activity Tracking) ---
PREDICTLEADS_API_KEY=
PREDICTLEADS_API_TOKEN=
# Base URL — v3 only (the v1 endpoint is deprecated)
PREDICTLEADS_API_URL=https://predictleads.com/api/v3

# --- Hunter API (Email Enrichment — email-finder + domain-search + verify) ---
HUNTER_API_KEY=your_hunter_api_key_here

# --- Claude API (Anthropic — Signal Enrichment) ---
CLAUDE_API_KEY=
CLAUDE_API_URL=https://api.anthropic.com/v1
# Default: claude-haiku-4-5-20251001 (cheaper, faster — good for enrichment)
# For higher quality: claude-sonnet-4-6
CLAUDE_MODEL=claude-haiku-4-5-20251001
# Set to true ONLY after confirming email generation works end-to-end in testing.
# Leaving false prevents surprise Claude API charges during development.
CLAUDE_EMAILS_ENABLED=false

# --- Airtable (Live Signal Database) ---
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Signals

# --- Email / SMTP (Gmail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Starfish Signal Monitor <noreply@starfishmonitor.com>
EMAIL_TO_TESTING=
EMAIL_TO_PRODUCTION=

# --- Google Sheets (Client-facing signal view) ---
GOOGLE_SHEET_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Telegram (Silent Monitoring — Gideon only) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- HubSpot CRM (Signal Push) ---
# Private App Token — create at: Settings → Integrations → Private Apps
# Required scopes: crm.objects.contacts.read, crm.objects.contacts.write,
#                  crm.objects.companies.read, crm.objects.companies.write,
#                  crm.objects.engagements.write, crm.associations.write
HUBSPOT_PRIVATE_APP_TOKEN=
# Auto-push to HubSpot (leave false until David/Zack confirm sequences are live and tested).
AUTO_PUSH_TO_HUBSPOT=false

# HubSpot Sender Emails
DAVID_SENDER_EMAIL=david@starfishco.com
ZACK_SENDER_EMAIL=zack@starfishco.com
ANDREW_SENDER_EMAIL=andrew@starfishco.com
COLE_SENDER_EMAIL=cole@starfishco.com

# HubSpot Owner IDs — find at: Settings → Users & Teams → click user → copy ID from URL
DAVID_HUBSPOT_OWNER_ID=
ZACK_HUBSPOT_OWNER_ID=
ANDREW_HUBSPOT_OWNER_ID=
COLE_HUBSPOT_OWNER_ID=

# HubSpot Sequence IDs — Starfish sequences (confirmed live)
HS_SEQ_JOB_CHANGE_STARFISH=
HS_SEQ_MA_STARFISH=
HS_SEQ_FUNDING_STARFISH=
HS_SEQ_NEWS_STARFISH=
HS_SEQ_WEBSITE_STARFISH=
HS_SEQ_BSI_STARFISH=

# HubSpot Sequence IDs — Claude sequences (paste after building shell sequences in HubSpot)
HS_SEQ_JOB_CHANGE_CLAUDE=
HS_SEQ_MA_CLAUDE=
HS_SEQ_FUNDING_CLAUDE=
HS_SEQ_NEWS_CLAUDE=
HS_SEQ_WEBSITE_CLAUDE=
HS_SEQ_BSI_CLAUDE=

# Soft launch date — set to confirmed Wednesday launch date
LAUNCH_DATE=

# --- HubSpot Enrollment Queue ---
# Airtable table for staging contacts before sequence enrollment.
# Create the table manually (same base as AIRTABLE_BASE_ID) with these columns
# (all Single Line Text unless noted):
#   Contact ID, Email, Sequence ID, Owner ID, Owner Email, AB Group, Signal Type,
#   Send Day (Number), Status, Queued At, Enrolled At, Error, Airtable Record ID
# Then paste the table ID (starts with tbl...) here.
AIRTABLE_QUEUE_TABLE_ID=
# Max successful enrollments per queue run (guards against runaway enrollment)
DAILY_ENROLLMENT_CAP=900
# Set to true ONLY after the queue table exists and you've verified a test enrollment.
# Leave false to run in dry-run mode (logs intent, makes no API calls).
AUTO_ENROLL_TO_SEQUENCE=false
# Cron schedule for enrollment queue — 8 AM EST on Tue/Wed/Thu by default.
# Runs after the 5 AM pipeline so morning contacts are already in HubSpot.
ENROLLMENT_CRON_SCHEDULE=0 8 * * 2,3,4

# --- System ---
NODE_ENV=production
TZ=America/New_York
CRON_SCHEDULE=0 5 * * 1,3,4
# Railway persistent volume mount path — set to /data on Railway (attach a Volume first).
# PDL cursor and AudienceLab cursor files are stored here so they survive container restarts.
# Leave blank locally (falls back to .tmp/).
RAILWAY_VOLUME_MOUNT_PATH=
# Puppeteer browser pool size — keep at 2 on Railway to limit memory usage
PUPPETEER_CONCURRENCY=2
# Set to true to skip Google Sheets sync (if Sheets credentials are not configured)
SKIP_SHEETS_SYNC=false
